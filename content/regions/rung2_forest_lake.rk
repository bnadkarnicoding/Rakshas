# Gray-box region (rungs 2-3): the first rough shape of the Release 1 land.
#
# Units are metres. Positions are "x z": x runs east (+) to west (-),
# z runs south (+) to north (-). The sun rises in the east.
#
# This is a placeholder layout to test the engine, not the final map.

terrain
  size: 600
  resolution: 301
  noise_height: 0.6
  noise_scale: 18
  seed: 7
  # The texture carries the colour; 'color' tints it (1 1 1 = as painted).
  texture: earth.png
  color: 1 1 1

  # The ridge players will climb to look over the valley (a "Vista" spot later).
  ridge lookout_ridge
    from: 45 -25
    to: 85 -80
    width: 34
    height: 12

  hill north_hill
    center: -35 -55
    radius: 38
    height: 10

  hill west_rise
    center: -70 10
    radius: 30
    height: 6

  # Flat ground where the village will stand.
  clearing village
    center: 0 0
    radius: 16
    blend: 12
    height: 0

# --- Placeholder objects -------------------------------------------------

prop stone_block
  position: 0 0
  size: 1.5 1.5 1.5
  yaw: 15
  texture: sandstone.png
  color: 0.85 0.82 0.80

prop sandstone_pillar
  position: -2.6 -1.6
  size: 0.7 3.5 0.7
  yaw: 20
  texture: sandstone.png
  color: 1 1 1

prop low_step
  position: 2.4 -0.9
  size: 2.6 0.5 1.6
  yaw: -10
  texture: sandstone.png
  color: 0.9 0.88 0.85

# Huts are 3D models (glTF, the format Blender exports). The doorway faces
# the model's front; yaw turns it (here, toward the village centre).
prop hut_a
  shape: model
  model: models/hut_round.gltf
  position: -8 -7
  yaw: 49

prop hut_b
  shape: model
  model: models/hut_round.gltf
  position: 8 -6
  yaw: -53

prop hut_c
  shape: model
  model: models/hut_round.gltf
  position: -3 -14
  yaw: 12

prop ridge_marker
  position: 58 -42
  size: 1 4 1
  color: 0.70 0.55 0.40

prop hill_stone_1
  position: -30 -50
  size: 1.2 5 1.2
  color: 0.70 0.55 0.40

prop hill_stone_2
  position: -38 -56
  size: 1.2 6 1.2
  yaw: 10
  color: 0.70 0.55 0.40

# --- Trees and grass ------------------------------------------------------
# Placed automatically inside each area, keeping out of clearings, away from
# objects and off steep ground. Change 'seed' for a different arrangement.

forest north_woods
  center: -35 -50
  radius: 42
  count: 70
  seed: 3

forest west_grove
  center: -62 12
  radius: 28
  count: 35
  seed: 11

forest village_shade
  center: 22 22
  radius: 16
  count: 10
  seed: 5

grass meadow
  center: 0 0
  radius: 55
  density: 2
  seed: 1

# Placeholder people (figures) for the duel and conversation spots.
prop duel_opponent
  shape: figure
  position: -24 14
  yaw: 180
  color: 0.30 0.32 0.40

prop village_elder
  shape: figure
  position: 11 7
  yaw: 120
  color: 0.55 0.48 0.30

# --- Camera zones ------------------------------------------------------------
#
# framing: explore, vista, duel or conversation. The camera glides into a
# zone's framing as the player walks in, and back out as they leave.
# focus: what the framing looks toward (the view, the opponent, the speaker).

camera_zone ridge_top
  framing: vista
  center: 65 -52
  radius: 18
  focus: 0 0

camera_zone duel_ground
  framing: duel
  center: -24 18
  radius: 7
  focus: -24 14

camera_zone elder_talk
  framing: conversation
  center: 9 9
  radius: 4.5
  focus: 11 7

# --- Where the player and view start --------------------------------------

# facing is in degrees: 0 = north, 90 = west, -90 = east, 180 = south.
player
  start: 0 12
  facing: 0

# For the follow camera, target is ignored (the camera follows the player).
camera
  distance: 6
  yaw: 0
  pitch: 14
